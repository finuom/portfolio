GITHUB_USERNAME=finuom
# Token fine-grained (somente leitura). Necessário para incluir repositórios privados.
GITHUB_TOKEN=
# stats = privados só entram nas estatísticas | anonymous = cards sem nome | full = mostra nome/descrição
PRIVATE_REPOS=stats
# Domínios do frontend autorizados (separados por vírgula)
ALLOWED_ORIGINS=http://localhost:5173
CACHE_TTL_SECONDS=3600
